   "title": "Создать заявку на отгул",
   "description": "Создаёт заявку на отгул в сервисе «Отсутствия», уведомляет наставника и руководителя, возвращает номер заявки.",
   "side_effects": "write",
   "requires_confirmation": true,
   "input_schema": {
    "additionalProperties": false,
    "properties": {
     "date": {
      "description": "Дата отгула, YYYY-MM-DD",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
     },
     "intern_id": {
      "minLength": 1,
      "type": "string"
     },
     "notify": {
      "items": {
       "enum": [
        "mentor",
        "team_lead"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "reason": {
      "maxLength": 300,
      "minLength": 3,
      "type": "string"
     },
     "time_from": {
      "description": "Начало, HH:MM",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
      "type": "string"
     },
     "time_to": {
      "description": "Окончание, HH:MM",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
      "type": "string"
     }
    },
    "required": [
     "intern_id",
     "date",
     "reason"
    ],
    "type": "object"
   },
   "output_schema": {
    "properties": {
     "date": {
      "type": "string"
     },
     "is_synthetic": {
      "type": "boolean"
     },
     "notified": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "request_number": {
      "description": "Например #ABS-2026-84",
      "type": "string"
     },
     "status": {
      "enum": [
       "pending_approval"
      ],
      "type": "string"
     },
     "time_from": {
      "type": "string"
     },
     "time_to": {
      "type": "string"
     }
    },
    "required": [
     "request_number",
     "status",
     "date",
     "notified",
     "is_synthetic"
    ],
    "type": "object"
   },
   "errors": [
    {
     "code": "INVALID_ARGUMENTS",
     "description": "Дата в прошлом, time_to раньше time_from"
    },
    {
     "code": "DUPLICATE",
     "description": "Заявка на эту дату уже существует"
    }
   ],
   "allowed_for_viewer": true
  },
