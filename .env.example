# Пример конфигурации AI-Buddy (без секретов). Скопируйте в .env при необходимости:
#   cp .env.example .env
# Без .env всё работает «из коробки» на детерминированном Smart Engine.

# ---------- Внешняя LLM (необязательно) ----------
# Сервис: любой OpenAI-совместимый API (/chat/completions с function calling):
# OpenAI, OpenRouter, vLLM, Ollama (http://host.docker.internal:11434/v1) и т. п.
# Если LLM_API_KEY или LLM_MODEL пусты, либо сервис недоступен / отвечает ошибкой / не укладывается
# в таймаут — бэкенд бесшовно отвечает Smart Engine, все три сценария остаются проходимыми.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_TIMEOUT_MS=12000

# ---------- Порты на хосте ----------
FRONTEND_PORT=3000
BACKEND_PORT=8080

# ---------- Хранилища (в docker compose заданы автоматически) ----------
# Пустые значения = in-memory fallback (локальный запуск без Docker, тесты).
# DATABASE_URL=postgres://aibuddy:aibuddy@localhost:5432/aibuddy?sslmode=disable
# REDIS_URL=redis://localhost:6379/0
# STORAGE_STRICT=false        # true — не стартовать, если PostgreSQL/Redis недоступны

# ---------- Поведение ----------
# SMART_DELAY_MS=300          # имитация «печатает…» Smart Engine (по умолчанию из спецификации)
# STREAM_CHUNK_DELAY_MS=12    # пауза между фрагментами текста в SSE
# CORS_ORIGINS=*              # список источников через запятую; за nginx не требуется
